# 默认：文本文件统一在仓库中存为 LF
* text=auto eol=lf

# Shell 脚本必须是 LF（Git Bash / Linux 要求）
*.sh text eol=lf

# PowerShell 脚本保持 CRLF（Windows 原生）
*.ps1 text eol=crlf

# Markdown / 配置文件
*.md text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 二进制文件，不处理行尾
*.zip binary
*.whl binary
*.exe binary
*.dll binary
*.png binary
*.jpg binary
